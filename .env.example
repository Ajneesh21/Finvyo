# PostgreSQL database connection URL
DATABASE_URL=postgresql://finvyo:finvyo_db_pass@localhost:5432/finvyo
POSTGRES_PASSWORD=finvyo_db_pass

# Redis connection URL (Optional: falls back to in-memory caching if not provided)
REDIS_URL=redis://localhost:6379

# Port configuration
PORT=3000
NODE_ENV=development

# Auth - Secret key to sign JWT tokens (minimum 32 characters; generate with: openssl rand -hex 32)
JWT_SECRET=your_random_secret_here_min_32_characters

# Database SSL configuration (Optional: defaults to true in production)
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_CA_CERT=

# Optional Stock Market Data APIs (Default: free Yahoo Finance API, no key required)
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
