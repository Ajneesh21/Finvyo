# Redis connection URL (Optional: falls back to in-memory caching if not provided)
REDIS_URL=redis://localhost:6379

# Port configuration
PORT=3000
NODE_ENV=development

# Optional Stock Market Data APIs (Default: free Yahoo Finance API, no key required)
# FINNHUB_API_KEY=your_finnhub_api_key_here
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
