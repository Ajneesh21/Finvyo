# Redis connection URL (Optional: falls back to in-memory caching if not provided)
REDIS_URL=redis://localhost:6379

# Port configuration
PORT=3000
NODE_ENV=development

# Auth - Password to access the app
ADMIN_PASSWORD=your_strong_password_here

# Auth - Secret key to sign JWT tokens (generate with: openssl rand -hex 32)
JWT_SECRET=your_random_secret_here

# Optional Stock Market Data APIs (Default: free Yahoo Finance API, no key required)
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
